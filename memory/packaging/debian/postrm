#!/bin/sh
# amadeos-memory: after removal the system goes back to the settings of the Debian packages at the next start;
# the running earlyoom gets its own options again now.
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl try-restart earlyoom.service || true
fi
